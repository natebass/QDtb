{
  "editor.wordWrap": "on",
  // "editor.fontSize": 13.2,
  //   "editor.fontFamily": "'JetBrainsMono Nerd Font', 'CaskaydiaCove Nerd Font', 'Lekton Nerd Font Mono', 'Cousine Nerd Font', 'monospace', monospace",
  "editor.lineNumbers": "off",
  "editor.lineHeight": 1.2,
  "editor.cursorBlinking": "solid",
  "editor.guides.indentation": false,
  "editor.guides.highlightActiveIndentation": false,
  "editor.guides.highlightActiveBracketPair": false,
  "editor.foldingHighlight": false,
  "editor.fontVariations": true,
  "editor.fontLigatures": true,
  "editor.minimap.scale": 2,
  "editor.wordSeparators": "`~!@#%^&*()-=+[{]}\\|;:'\",.<>/?",
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "editor.renderLineHighlight": "none",
  "editor.occurrencesHighlight": "off",
  // "editor.renderLineHighlightOnlyWhenFocus": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "explorer.excludeGitIgnore": true,
  "extensions.ignoreRecommendations": true,
  "extensions.autoCheckUpdates": true,
  "breadcrumbs.enabled": false,
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.console.fontSize": 11,
  "zenMode.showTabs": "none",
  "markdown.preview.lineHeight": 1,
  "notebook.output.fontSize": 14,
  "notebook.output.lineHeight": 1,
  "notebook.markup.fontSize": 14,
  "notebook.insertFinalNewline": true,
  "files.exclude": {
    "**/.git": false
  },
  "files.autoSave": "onFocusChange",
  "files.defaultLanguage": "powershell",
  "git.openRepositoryInParentFolders": "always",
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "diffEditor.renderSideBySide": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "scm.inputFontSize": 12,
  "scm.diffDecorations": "minimap",
  "terminal.integrated.env.linux": {},
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.tabs.defaultIcon": "lightbulb",
  "terminal.integrated.fontFamily": "'Cousine Nerd Font'",
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.env.windows": {},
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorStyleInactive": "none",
  "terminal.integrated.confirmOnKill": "never",
  "terminal.integrated.initialHint": false,
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.toggleSidebarVisibility",
    "workbench.action.toggleAuxiliaryBar",
    "workbench.action.openGlobalKeybindings",
    "workbench.action.openRecent"
  ],
  // "powershell.integratedConsole.suppressStartupBanner": true,
  "powershell.pester.codeLens": false,
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.codeFolding.showLastLine": false,
  "powershell.promptToUpdatePowerShell": false,
  "powershell.buttons.showPanelMovementButtons": true,
  "powershell.sideBar.CommandExplorerVisibility": true,
  "powershell.integratedConsole.startLocation": "Editor",
  "powershell.integratedConsole.focusConsoleOnExecute": false,
  "window.openWithoutArgumentsInNewWindow": "off",
  "window.menuBarVisibility": "visible",
  "window.restoreWindows": "none",
  "window.commandCenter": false,
  "window.title": "${dirty}${activeEditorShort}${separator}${dirty}${activeRepositoryName}${separator}${activeRepositoryBranchName}${separator}${profileName}",
  // "window.title": "${dirty}${activeEditorLong}",
  // "window.title": "${dirty}${activeRepositoryName}${separator}${activeRepositoryBranchName}${separator}${profileName}",
  "workbench.iconTheme": "kary-pro-colors-icons",
  "workbench.editor.empty.hint": "hidden",
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  "workbench.colorTheme": "PowerShell ISE",
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.enablePreview": false,
  "workbench.activityBar.location": "top",
  "workbench.editor.pinnedTabSizing": "compact",
  "security.workspace.trust.startupPrompt": "always",
  "security.workspace.trust.untrustedFiles": "open",
  "update.showReleaseNotes": false,
  "update.mode": "manual",
  "extensions.autoUpdate": "on",
  "task.allowAutomaticTasks": "on",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "powershell": false,
    "jsonc": false,
    "typescriptreact": true,
    "javascript": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.newWorkspaceCreation.enabled": true,
  "chat.permissions.default": "autopilot",
  "chat.mcp.gallery.enabled": true,
  "editor.tabCompletion": "on",
  "cSpell.userWords": [
    "Cobex",
    "deca",
    "lexend",
    "nateb",
    "tabler",
    "turbopack"
  ],
  "vscode-edge-devtools.headless": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.experimental.useTsgo": true,
  "debug.openDebug": "neverOpen",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "redhat.telemetry.enabled": true,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "ruff.lint.select": [],
  "ruff.lint.ignore": [
    "ANN201",
    "ANN202",
    "ANN205",
    "ANN204",
    "ANN206"
  ],
  // "editor.codeActionsOnSave": {
  //   "source.organizeImports": "always"
  // },
  // "editor.formatOnSave": true,
  // "[json]": {
  //     "editor.defaultFormatter": "vscode.json-language-features"
  // },
  // "[javascript]": {
  //     "editor.defaultFormatter": "vscode.typescript-language-features"
  // },
  //   "[jsonc]": {
  //     "editor.defaultFormatter": "vscode.json-language-features"
  //   },
  //   "[go]": {
  //     "editor.defaultFormatter": "golang.go"
  //   },
  // "[python]": {
  //   "editor.defaultFormatter": "charliermarsh.ruff"
  // },
  //   "[typescriptreact]": {
  //   "editor.defaultFormatter": "vscode.typescript-language-features"
  // },
  // "[xml]": {
  //   "editor.defaultFormatter": "redhat.vscode-xml"
  // },
  // "[java]": {
  //   "editor.defaultFormatter": "redhat.java"
  // },
  // "[powershell]": {
  //   "editor.defaultFormatter": "ms-vscode.powershell"
  // },
  // "[github-actions-workflow]": {
  //   "editor.defaultFormatter": "redhat.vscode-yaml"
  // },
  // "[yaml]": {
  //   "editor.defaultFormatter": "redhat.vscode-yaml"
  // },
  //   "python.pythonPath": "/usr/bin/python3",
  //   "java.configuration.checkProjectSettingsExclusions": false,
  //   "java.semanticHighlighting.enabled": true,
  //   "maven.executable.preferMavenWrapper": true,
  // "window.openFoldersInNewWindow": "default",
  // "markdownlint.customRules": [
  //     "{docsmsft.docs-linting}/markdownlint-custom-rules/rules.js"
  // ],
  // "[lua]": {
  //   "editor.defaultFormatter": "sumneko.lua"
  // },
  // "markdownlint.config": {
  //     "MD025": {
  //     "front_matter_title": ""
  //     }
  // },
  "peacock.favoriteColors": [
    {
      "name": "Angular Red",
      "value": "#dd0531"
    },
    {
      "name": "Azure Blue",
      "value": "#007fff"
    },
    {
      "name": "JavaScript Yellow",
      "value": "#f9e64f"
    },
    {
      "name": "Mandalorian Blue",
      "value": "#1857a4"
    },
    {
      "name": "Node Green",
      "value": "#215732"
    },
    {
      "name": "React Blue",
      "value": "#61dafb"
    },
    {
      "name": "Something Different",
      "value": "#832561"
    },
    {
      "name": "Svelte Orange",
      "value": "#ff3d00"
    },
    {
      "name": "Vue Green",
      "value": "#42b883"
    }
  ]
}