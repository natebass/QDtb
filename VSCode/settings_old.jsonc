{
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "scm.diffDecorations": "minimap",
  // 🔚 Minimal
  // 🔚 Confirmations
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "git.confirmSync": false,
  // 🔚 Confirmations
  // 🔚 Misc
  "liveServer.settings.port": 5000,
  "markdownlint.customRules": [
    "{docsmsft.docs-linting}/markdownlint-custom-rules/rules.js"
  ],
  "diffEditor.renderSideBySide": false,
  "extensions.ignoreRecommendations": true,
  "git.enableSmartCommit": true,
  "extensions.autoCheckUpdates": true,
  "team.showWelcomeMessage": false,
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "asa.enableFeedbackPrompt": false,
  "vs-kubernetes": {
    "vs-kubernetes.draft-path": "/Users/nwb/.vs-kubernetes/tools/draft/darwin-amd64/draft",
    "vs-kubernetes.helm-path": "/Users/nwb/.vs-kubernetes/tools/helm/darwin-amd64/helm",
    "vs-kubernetes.minikube-path": "/Users/nwb/.vs-kubernetes/tools/minikube/darwin-amd64/minikube",
    "vs-kubernetes.kubectl-path": "/Users/nwb/.vs-kubernetes/tools/kubectl/kubectl",
    "vscode-kubernetes.kubectl-path.linux": "/home/nwb/.local/state/vs-kubernetes/tools/kubectl/kubectl",
    "vscode-kubernetes.helm-path.linux": "/home/nwb/.local/state/vs-kubernetes/tools/helm/linux-amd64/helm",
    "vscode-kubernetes.minikube-path.linux": "/home/nwb/.local/state/vs-kubernetes/tools/minikube/linux-amd64/minikube"
  },
  "markdownlint.config": {
    "MD025": {
      "front_matter_title": ""
    },
    "MD028": false
  },
  "files.exclude": {
    "**/.git": false
  },
  "update.mode": "manual",
  "cmake.configureOnOpen": false,
  "makefile.configureOnOpen": false,
  "msiot-vscode-openenclave.systemRequirementsPassed": "1.0.10",
  "cSpell.userWords": [
    "Cobex",
    "deca",
    "lexend",
    "tabler",
    "turbopack"
  ],
  "debug.showBreakpointsInOverviewRuler": true,
  "codespaces.accountProvider": "Microsoft",
  "python.pythonPath": "/usr/bin/python3",
  "java.configuration.checkProjectSettingsExclusions": false,
  "java.semanticHighlighting.enabled": true,
  "maven.executable.preferMavenWrapper": true,
  "powershell.promptToUpdatePowerShell": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "debug.console.fontSize": 11,
  "workbench.startupEditor": "none",
  "githubPullRequests.pullBranch": "never",
  "debug.javascript.suggestPrettyPrinting": false,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "aeschli.vscode-css-formatter"
  },
  "editor.cursorBlinking": "solid",
  "editor.guides.indentation": false,
  "remote.SSH.remotePlatform": {
    "ec2-35-160-93-152.us-west-2.compute.amazonaws.com": "linux"
  },
  "git.autofetch": true,
  "redhat.telemetry.enabled": true,
  "debug.allowBreakpointsEverywhere": true,
  "svelte.enable-ts-plugin": true,
  "editor.lineHeight": 1.2,
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.editor.empty.hint": "hidden",
  "hdinsight.azureEnvironment": "Azure",
  "editor.formatOnSave": true,
  "files.autoSave": "onFocusChange",
  "yaml.schemas": {
    "file:///home/nwb/.vscode/extensions/docsmsft.docs-yaml-1.0.1/dist/toc.schema.json": "/toc\\.yml/i"
  },
  "security.workspace.trust.untrustedFiles": "open",
  "git.openRepositoryInParentFolders": "always",
  "codeQL.telemetry.enableTelemetry": true,
  "security.workspace.trust.startupPrompt": "always",
  "window.restoreWindows": "none",
  "editor.fontFamily": "'CaskaydiaCove Nerd Font', 'Lekton Nerd Font Mono', 'Cousine Nerd Font', 'JetBrainsMono Nerd Font', 'monospace', monospace",
  "explorer.confirmPasteNative": false,
  "terminal.integrated.fontSize": 12,
  "scm.inputFontSize": 12,
  "markdown.preview.fontSize": 11,
  "terminal.integrated.lineHeight": 1,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "testing.coverageToolbarEnabled": true,
  "testing.automaticallyOpenPeekViewDuringAutoRun": true,
  "testing.alwaysRevealTestOnStateChange": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "files.eol": "\n",
  "debug.openDebug": "neverOpen",
  "editor.tabCompletion": "on",
  "powershell.integratedConsole.focusConsoleOnExecute": false,
  "files.defaultLanguage": "powershell",
  "editor.wordSeparators": "`~!@#%^&*()-=+[{]}\\|;:'\",.<>/?",
  "powershell.buttons.showPanelMovementButtons": true,
  "powershell.codeFolding.showLastLine": false,
  "powershell.sideBar.CommandExplorerVisibility": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "extensions.autoUpdate": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "terminal.integrated.env.windows": {},
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "ruff.lint.select": [],
  "ruff.lint.ignore": [
    "ANN201",
    "ANN202",
    "ANN205",
    "ANN204",
    "ANN206"
  ],
  "terminal.integrated.env.linux": {},
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "editor.minimap.scale": 2,
  "terminal.integrated.cursorStyle": "line",
  "editor.fontLigatures": true,
  "editor.fontVariations": true,
  "update.showReleaseNotes": false,
  "powershell.integratedConsole.suppressStartupBanner": true,
  "vite.port": 5173,
  "editor.renderLineHighlight": "none",
  "editor.renderLineHighlightOnlyWhenFocus": true,
  "editor.guides.highlightActiveIndentation": false,
  "editor.guides.highlightActiveBracketPair": false,
  "editor.foldingHighlight": false,
  "terminal.integrated.fontLigatures": true,
  "terminal.integrated.fontFamily": "'Cousine Nerd Font'",
  "workbench.editor.editorActionsLocation": "titleBar",
  "powershell.integratedConsole.startLocation": "Editor",
  "powershell.integratedConsole.showOnStartup": false,
  "terminal.integrated.tabs.defaultIcon": "lightbulb",
  "breadcrumbs.enabled": false,
  "window.menuBarVisibility": "visible",
  "zenMode.showTabs": "none",
  "@azure.argTenant": "",
  "markdown.preview.lineHeight": 1,
  "notebook.output.fontSize": 14,
  "notebook.output.lineHeight": 1,
  "notebook.markup.fontSize": 14,
  "peacock.favoriteColors": [
    {
      "name": "Angular Red",
      "value": "#dd0531"
    },
    {
      "name": "Azure Blue",
      "value": "#007fff"
    },
    {
      "name": "JavaScript Yellow",
      "value": "#f9e64f"
    },
    {
      "name": "Mandalorian Blue",
      "value": "#1857a4"
    },
    {
      "name": "Node Green",
      "value": "#215732"
    },
    {
      "name": "React Blue",
      "value": "#61dafb"
    },
    {
      "name": "Something Different",
      "value": "#832561"
    },
    {
      "name": "Svelte Orange",
      "value": "#ff3d00"
    },
    {
      "name": "Vue Green",
      "value": "#42b883"
    }
  ],
  "vscode-edge-devtools.headless": false,
  "window.commandCenter": false,
  "editor.fontSize": 13.2,
  "editor.occurrencesHighlight": "off",
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "top",
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua"
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "powershell": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "editor.lineNumbers": "off",
  "workbench.colorTheme": "Default Light+",
  "workbench.iconTheme": "kary-pro-colors-icons",
  "window.title": "${dirty}${activeRepositoryName}${separator}${activeRepositoryBranchName}${separator}${profileName}",
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "editor.wordWrap": "on",
  "notebook.insertFinalNewline": true
